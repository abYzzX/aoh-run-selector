{
  "name": "aoh-run-selector",
  "displayName": "AOH - Run Selector",
  "description": "AOH - Rider-style launch configuration controls in the VS Code status bar.",
  "version": "0.0.0",
  "publisher": "AbYzzX",
  "icon": "media/aoh-run-selector.png",
  "license": "MIT",
    "repository": {
    "type": "git",
    "url": "https://github.com/abYzzX/aoh-run-selector.git"
  },
  "bugs": {
    "url": "https://github.com/abYzzX/aoh-run-selector/issues"
  },
  "homepage": "https://github.com/abYzzX/aoh-run-selectort#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Debuggers"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --test out/test/**/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.9.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "aoh.runSelector.build",
        "title": "Build Selected Configuration",
        "shortTitle": "Build",
        "icon": "$(aoh-build)"
      },
      {
        "command": "aoh.runSelector.run",
        "title": "Run Selected Configuration",
        "shortTitle": "Run",
        "icon": "$(play)"
      },
      {
        "command": "aoh.runSelector.debug",
        "title": "Debug Selected Configuration",
        "shortTitle": "Debug",
        "icon": "$(debug-alt)"
      },
      {
        "command": "aoh.runSelector.select",
        "title": "Select Launch Configuration",
        "shortTitle": "Select Launch",
        "icon": "$(list-selection)"
      },
      {
        "command": "aoh.runSelector.stop",
        "title": "Stop Running Configuration",
        "shortTitle": "Stop",
        "icon": "$(debug-stop)"
      },
      {
        "command": "aoh.runSelector.restart",
        "title": "Restart Selected Configuration",
        "shortTitle": "Restart",
        "icon": "$(debug-restart)"
      },
      {
        "command": "aoh.runSelector.restartDebug",
        "title": "Restart Selected Configuration in Debug Mode",
        "shortTitle": "Restart in Debug Mode",
        "icon": "$(debug-alt)"
      }
    ],
    "icons": {
      "aoh-build": {
        "description": "AOH Build",
        "default": {
          "fontPath": "./media/fonts/aoh-run-selector-icons.woff",
          "fontCharacter": "\\E001"
        }
      }
    }
  }
}
