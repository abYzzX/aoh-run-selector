{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AOH - Run Selector",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "compile: run-selector"
    }
  ]
}